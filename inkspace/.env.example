# ============================================================================
# INKSPACE — ENVIRONMENT CONFIGURATION
# Copy this file to .env and populate values before starting the server.
# Never commit .env containing real secrets to version control.
# ============================================================================

# PostgreSQL Database Connection (Required)
DATABASE_URL="postgresql://inkspace_user:replace_with_password@localhost:5432/inkspace?schema=public"

# Auth.js Secret for Session Encryption & CSRF Signing (Required, min 32 chars)
# Generate via: openssl rand -base64 32
AUTH_SECRET="replace-with-strong-32-byte-secret-key"

# Canonical Public Site URL (Required for SEO canonical tags, sitemap, and Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Anthropic Claude API Configuration (Optional at boot; required for live AI features)
# Obtain an API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# Administrator Bootstrap Credentials (Used ONLY by `npm run admin:bootstrap`)
# Do not leave plaintext passwords in production environment variables after bootstrap.
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""

# Local Asset Upload Configuration (Optional)
UPLOAD_DIR="./public/uploads"
MAX_UPLOAD_SIZE_BYTES="5242880"
